  "cards": [
    {
      "dot": "rose",
      "title": "信任邊界",
      "items": [
        "零外連：報表以 CSP 鎖死（connect-src 'none'）",
        "serve：掛載限 CYTRACE_SCAN_ROOTS、上傳解壓至 input/；CLI 不限路徑",
        "input/ 掃描結束後預設刪除（取消／重啟例外：#39）"
      ]
    },
    {
      "dot": "cyan",
      "title": "產出物",
      "items": [
        "run／batch：<target>.report.html（--cbom 併入報表）",
        "scan：sbom.cdx.json · grype.json（--spdx、--cbom 另落檔）",
        "serve：report.html · scan-result.json · SPDX 一律產出"
      ]
    },
    {
      "dot": "emerald",
      "title": "交付形態",
      "items": [
        "單一靜態 binary：內嵌控制台、報表樣板與 cytrace-i18n 雙語字串",
        "CLI／server 編排管線後呼叫 report 渲染（core → report 為資料流）",
        "安裝包含三引擎與 DB 快照；容器 distroless、/db 唯讀；minisign 簽 SHA256SUMS"
      ]
    }
  ]
