# 引擎版本與校驗和單一事實源（ADR-012）。
# package.sh / package.ps1 / Dockerfile ARG / CI 皆引用；bump 引擎版本只改這裡。
#
# 取得 SHA256：curl -sL https://github.com/anchore/<name>/releases/download/v<ver>/<name>_<ver>_checksums.txt
SYFT_VERSION=1.45.1
GRYPE_VERSION=0.114.0
# linux_amd64 tar.gz 校驗和（Dockerfile 下載後比對，不符即 build fail）
SYFT_LINUX_AMD64_SHA256=20c84195e24927f50a3b2269946be51f4c4abc9d2f145fee7388b4199149f716
GRYPE_LINUX_AMD64_SHA256=edda0968d8827daab01d32b3cd7de192ae0915005e7bbfcfef9e68e79bc43343

# ── CBOM 引擎 cbomkit-theia（ADR-013）──
# 與 syft/grype 不同：**自源碼建置**，不依賴上游 release binary（ADR-013 決策 1）。
# 因此釘的是 tag 對應的 commit SHA；binary SHA256 為可重現建置的產物紀錄，
# Dockerfile 建完會比對，不符即 build fail。
THEIA_VERSION=1.1.2
THEIA_COMMIT=dcd95ac86d1cbe6e867ff3ee059b9ef77bac6a59
# 建置工具鏈（與上游 go.mod 宣告一致；以 digest 釘選，比照其他 base image）
THEIA_GO_IMAGE=golang:1.26.1@sha256:cd78d88e00afadbedd272f977d375a6247455f3a4b1178f8ae8bbcb201743a8a
# 以決策 1 的固定參數建置之產物 SHA256（2026-09-22 於兩個不同路徑建置驗證一致）
# CGO_ENABLED=0 GOFLAGS=-mod=vendor go build -trimpath -buildvcs=false -ldflags="-s -w -buildid="
THEIA_LINUX_AMD64_SHA256=672a3d06ce32d1a242f0f4c10dc0280c257fa4717ecf9c7c6e5f2718bf3adecf
# Windows 版（T911）：同上參數加 GOOS=windows GOARCH=amd64 交叉編譯（Dockerfile theia-builder-windows）。
# 2026-10-05 於兩個不同源碼路徑建置驗證一致。package.ps1 取用前比對此值。
THEIA_WINDOWS_AMD64_SHA256=3e2e437105759963a4ef8ff0ce477cececca80436c1beff521a14c1286d21073

# ── minisign（T920）──
# **只供 CI 冒煙測試**實際走一次打包腳本的簽章路徑（拋棄式金鑰），不隨交付包散布；
# 正式交付在交付工作站以受管私鑰簽章（DELIVERY_SOP §3）。ISC 授權。
# 資產已以作者公鑰 RWQf6LRCGA9i53mlYecO4IzT51TGPpvWucNSCh1CBM0QTaLn73Y7GFO3（上游 README）驗章後才釘 SHA256。
MINISIGN_VERSION=0.12
MINISIGN_LINUX_SHA256=9a599b48ba6eb7b1e80f12f36b94ceca7c00b7a5173c95c3efc88d9822957e73
MINISIGN_WINDOWS_SHA256=37b600344e20c19314b2e82813db2bfdcc408b77b876f7727889dbd46d539479
